# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
SITE_URL="http://localhost:3000"

# ==========================================
# ADMIN SECURITY & LEADS API PROTECTION
# Clé secrète requise pour GET/PATCH /api/leads*
# En-tête : Authorization: Bearer <ADMIN_API_KEY> ou x-admin-key: <ADMIN_API_KEY>
# ==========================================
ADMIN_API_KEY="votre_cle_secrete_admin_hautement_securisee_2026"

# ==========================================
# TRANSACTIONAL EMAIL ROUTING CONFIGURATION
# (Resend, Brevo, SendGrid, Postmark)
# ==========================================

# Option A: Resend API (Recommended)
RESEND_API_KEY="re_123456789_abcdef"

# Option B: Standard Professional SMTP (Brevo / Sendinblue, Postmark, SendGrid)
# SMTP_HOST="smtp-relay.brevo.com"
# SMTP_PORT=587
# SMTP_USER="your-login@domain.com"
# SMTP_PASS="your-smtp-master-password"
# SMTP_SECURE="false"

# Addresses
SENDER_EMAIL="export@cacao-ivoire-industries.com"
SENDER_NAME="Desk Export — Usine Cacao Ivoire"
COMMERCIAL_EMAIL_TO="commercial-desk@cacao-ivoire-industries.com"

# ==========================================
# DATABASE PERSISTENCE (Optional Remote Mirror)
# SQLite locale est active par défaut dans server/leads.db
